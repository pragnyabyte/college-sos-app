MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?appName=APP_NAME
MONGODB_DB_NAME=school_erp_sos
SOS_SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=4000

# Permanent Responder & Firebase Configuration
SOS_RESPONDER_PIN=RESP-911
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_VAPID_KEY=your-web-push-public-vapid-key

# Production Backend URL for Frontend (leave blank in local dev to use Vite proxy; set to Railway URL in production)
VITE_API_URL=https://your-railway-backend.up.railway.app

# Backend Allowed CORS Origins (comma-separated; defaults to Firebase domains + localhost + local LAN)
ALLOWED_ORIGINS=https://college-sos-app-26aec.web.app,https://college-sos-app-26aec.firebaseapp.com