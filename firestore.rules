rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check non-empty string
    function isNonEmptyString(text) {
      return text is string && text.size() > 0 && text.size() <= 200;
    }

    // Students collection: each student's document is keyed by their normalized registration ID
    match /students/{regdNo} {
      // Allow fetching student records for login credential verification and responder student directory
      allow read: if true;
      
      // Allow new student registration only if:
      // 1. Document does not already exist (prevents duplicate registration)
      // 2. Contains valid name, regdNo matching document ID, and STUDENT role
      allow create: if request.resource.data.regdNo == regdNo
                    && isNonEmptyString(request.resource.data.name)
                    && isNonEmptyString(request.resource.data.regdNo)
                    && request.resource.data.role == 'STUDENT'
                    && !exists(/databases/$(database)/documents/students/$(regdNo));
                    
      // Allow emergency responders to delete student registrations
      allow delete: if true;
      allow update: if false;
    }

    // Emergency Responders collection: pre-authorized responder identity
    match /emergency_responders/{responderId} {
      allow get: if true;
      allow list: if false; // Do not expose all responder accounts to public enumeration
      
      // Deny public registration of arbitrary new responder accounts.
      // Only allowed when explicitly migrating an existing verified responder identity.
      allow create: if request.resource.data.role == 'RESPONDER'
                    && request.resource.data.migratedFrom is string
                    && exists(/databases/$(database)/documents/emergency_responders/$(request.resource.data.migratedFrom));
                    
      allow delete: if false; // Responders cannot be deleted
      
      // Updates permitted only for authorized responder documents
      allow update: if request.resource.data.role == 'RESPONDER'
                    && (request.resource.data.authorized == true || request.resource.data.deactivated == true)
                    && request.resource.data.sessionVersion >= resource.data.sessionVersion;
    }

    // Responder OTPs collection for email recovery
    match /responder_otps/{otpId} {
      allow list: if false; // Deny public enumeration of OTPs
      allow get: if true;
      
      // Allow creation of secure, salted, single-use OTP
      allow create: if request.resource.data.keys().hasAll(['otpId', 'responderId', 'hashedCode', 'salt', 'expiresAt', 'attempts', 'used'])
                    && request.resource.data.attempts == 0
                    && request.resource.data.used == false;
                    
      // Updates can ONLY increment attempts or mark used (cannot tamper with code, salt, or target)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'used', 'verifiedAt']);
      allow delete: if false;
    }

    // Responder Recovery Tokens collection
    match /responder_recovery_tokens/{tokenId} {
      allow list: if false; // Deny public enumeration of recovery tokens
      allow get: if true;
      
      allow create: if request.resource.data.keys().hasAll(['recoveryToken', 'responderId', 'used', 'expiresAt'])
                    && request.resource.data.used == false;
                    
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'completedAt', 'consumedAt']);
      allow delete: if false;
    }

    // Immutable Security Audit Logs collection
    match /responder_audit_logs/{logId} {
      // Append-only for recording security events without secrets
      allow create: if request.resource.data.keys().hasAll(['logId', 'action', 'timestamp'])
                    && !request.resource.data.keys().hasAny(['pin', 'prevPin', 'newPin', 'otp', 'rawCode', 'password', 'secret']);
      allow read, update, delete: if false; // Tamper-proof, public cannot read or alter audit logs
    }

    // Responder devices collection for push notification tokens
    match /responder_devices/{deviceId} {
      allow read: if true;
      allow write: if request.resource.data.responderId is string;
    }

    // Emergency Incidents collection
    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if request.resource.data.id == incidentId
                    && isNonEmptyString(request.resource.data.student_id)
                    && request.resource.data.status in ['SOS_SENT', 'DEPARTMENT_NOTIFIED'];
      allow update: if true;
      allow delete: if true;
    }

    // Incident Timeline collection
    match /timeline/{timelineId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
