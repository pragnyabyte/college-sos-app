<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EmergencySosResponder" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.EmergencySosResponder.Alert" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/alarm_red</item>
        <item name="android:statusBarColor">@color/alarm_red</item>
        <item name="android:navigationBarColor">@color/alarm_red</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
    </style>
</resources>
